# Copy to /etc/hamara-tunnel/hamara.env and chmod 600.
# This file is documentation for future automation and does not contain secrets.
PROFILE=standard
ROLE=foreign
WG_INTERFACE=wg0
WG_PORT=51820
TUNNEL_NETWORK=10.77.0.0/30
FOREIGN_TUNNEL_IP=10.77.0.1/30
IRAN_TUNNEL_IP=10.77.0.2/30
WAN_INTERFACE=eth0
MTU=1420
PERSISTENT_KEEPALIVE=25
ALLOWED_IPS=10.77.0.2/32
ENABLE_NAT=true
ENABLE_IPV4_FORWARDING=true
ENABLE_IPV6_FORWARDING=true
